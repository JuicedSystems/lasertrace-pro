{
  "name": "tiny-logo",
  "display_name": "Tiny Favicon / Low-res Logo",
  "description": "Upscale 4x, edge-preserving smooth, then trace with generous smoothing so pixel stairs become curves.",
  "tags": ["tiny", "favicon", "lowres"],
  "stack": {
    "ops": [
      {"op": "background_white", "enabled": true, "params": {"tolerance": 30}},
      {"op": "upscale", "enabled": true, "params": {"factor": 4.0, "method": "lanczos"}},
      {"op": "bilateral", "enabled": true, "params": {"d": 9, "sigma_color": 60, "sigma_space": 8}},
      {"op": "threshold", "enabled": true, "params": {"method": "otsu", "bias": 0}},
      {"op": "morph_open", "enabled": true, "params": {"radius_px": 1}},
      {"op": "despeckle", "enabled": true, "params": {"min_area_mm2": 0.05}},
      {"op": "fill_holes", "enabled": true, "params": {"max_area_mm2": 0.02}}
    ]
  },
  "trace": {
    "engine": "contour", "mode": "outline",
    "detail": 0.35, "threshold": 128, "despeckle_mm2": 0.05, "corner_sharpness": 0.4,
    "min_feature_mm": 0.2, "smoothness": 0.8,
    "curve_tol_mm": 0.06, "gap_close_mm": 0.05, "node_budget": null,
    "union_fills": true, "preserve_holes": true
  },
  "export": {"format": "dxf", "dxf_version": "R2000", "width_mm": 50.0, "origin": "bottom_left", "curves": "polyline", "flatten_tol_mm": 0.03, "precision": 3, "close_fills": true}
}
