{
  "$defs": {
    "DepthHatchSettings": {
      "description": "Optional in-app hatch generation per slice (for controllers that cannot\nrotate the hatch angle per pass themselves, or to lock the fill pattern).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "spacing_mm": {
          "default": 0.025,
          "title": "Spacing Mm",
          "type": "number"
        },
        "angle_start_deg": {
          "default": 0.0,
          "title": "Angle Start Deg",
          "type": "number"
        },
        "angle_step_deg": {
          "default": 37.0,
          "title": "Angle Step Deg",
          "type": "number"
        },
        "bidirectional": {
          "default": true,
          "title": "Bidirectional",
          "type": "boolean"
        },
        "contour_pass": {
          "default": true,
          "title": "Contour Pass",
          "type": "boolean"
        },
        "max_lines": {
          "default": 250000,
          "title": "Max Lines",
          "type": "integer"
        }
      },
      "title": "DepthHatchSettings",
      "type": "object"
    },
    "DepthSettings": {
      "description": "Grayscale height map -> N cumulative slices.\n\nHeight convention inside the pipeline: 0.0 = untouched surface,\n1.0 = full `total_depth_mm`. Slice i (1..levels) is the region deeper than\n(i - 0.5) / levels, so a pixel's pass count rounds its height and the\ndeepest pixels are engraved in every pass (that is what removes material\ncorrectly: each pass takes roughly the same thickness off wherever it hits).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "levels": {
          "default": 16,
          "title": "Levels",
          "type": "integer"
        },
        "dark_is_deep": {
          "default": true,
          "title": "Dark Is Deep",
          "type": "boolean"
        },
        "total_depth_mm": {
          "default": 0.5,
          "title": "Total Depth Mm",
          "type": "number"
        },
        "material": {
          "default": "stainless",
          "title": "Material",
          "type": "string"
        },
        "laser_w": {
          "default": 50.0,
          "title": "Laser W",
          "type": "number"
        },
        "removal_per_pass_um": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removal Per Pass Um"
        },
        "passes_per_slice": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passes Per Slice"
        },
        "z_step": {
          "default": true,
          "title": "Z Step",
          "type": "boolean"
        },
        "z_step_every_mm": {
          "default": 0.1,
          "title": "Z Step Every Mm",
          "type": "number"
        },
        "normalize": {
          "default": true,
          "title": "Normalize",
          "type": "boolean"
        },
        "black_point": {
          "default": 0,
          "title": "Black Point",
          "type": "integer"
        },
        "white_point": {
          "default": 255,
          "title": "White Point",
          "type": "integer"
        },
        "depth_gamma": {
          "default": 1.0,
          "title": "Depth Gamma",
          "type": "number"
        },
        "equalize": {
          "default": 0.0,
          "title": "Equalize",
          "type": "number"
        },
        "smoothing_mm": {
          "default": 0.05,
          "title": "Smoothing Mm",
          "type": "number"
        },
        "edge_preserve": {
          "default": true,
          "title": "Edge Preserve",
          "type": "boolean"
        },
        "zero_plane": {
          "default": "border",
          "enum": [
            "none",
            "border",
            "min"
          ],
          "title": "Zero Plane",
          "type": "string"
        },
        "floor": {
          "default": 0.02,
          "title": "Floor",
          "type": "number"
        },
        "photo_to_relief": {
          "default": false,
          "title": "Photo To Relief",
          "type": "boolean"
        },
        "relief_strength": {
          "default": 0.6,
          "title": "Relief Strength",
          "type": "number"
        },
        "feather_mm": {
          "default": 0.0,
          "title": "Feather Mm",
          "type": "number"
        },
        "min_island_mm2": {
          "default": 0.01,
          "title": "Min Island Mm2",
          "type": "number"
        },
        "draft_angle_deg": {
          "default": 8.0,
          "title": "Draft Angle Deg",
          "type": "number"
        },
        "quantize_png": {
          "default": false,
          "title": "Quantize Png",
          "type": "boolean"
        },
        "png_bits": {
          "default": 8,
          "enum": [
            8,
            16
          ],
          "title": "Png Bits",
          "type": "integer"
        },
        "png_black_is_deep": {
          "default": true,
          "title": "Png Black Is Deep",
          "type": "boolean"
        },
        "hatch": {
          "$ref": "#/$defs/DepthHatchSettings"
        }
      },
      "title": "DepthSettings",
      "type": "object"
    },
    "ExportProfile": {
      "properties": {
        "format": {
          "default": "dxf",
          "enum": [
            "dxf",
            "svg",
            "plt",
            "pdf",
            "eps",
            "png"
          ],
          "title": "Format",
          "type": "string"
        },
        "dxf_version": {
          "default": "R2000",
          "enum": [
            "R12",
            "R2000"
          ],
          "title": "Dxf Version",
          "type": "string"
        },
        "width_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 50.0,
          "title": "Width Mm"
        },
        "height_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Mm"
        },
        "origin": {
          "default": "bottom_left",
          "enum": [
            "top_left",
            "bottom_left",
            "center"
          ],
          "title": "Origin",
          "type": "string"
        },
        "flatten_layers": {
          "default": false,
          "title": "Flatten Layers",
          "type": "boolean"
        },
        "curves": {
          "default": "polyline",
          "enum": [
            "polyline",
            "spline",
            "arcs"
          ],
          "title": "Curves",
          "type": "string"
        },
        "flatten_tol_mm": {
          "default": 0.02,
          "title": "Flatten Tol Mm",
          "type": "number"
        },
        "precision": {
          "default": 3,
          "title": "Precision",
          "type": "integer"
        },
        "close_fills": {
          "default": true,
          "title": "Close Fills",
          "type": "boolean"
        },
        "strokes_to_fills": {
          "default": false,
          "title": "Strokes To Fills",
          "type": "boolean"
        },
        "stroke_outline_width_mm": {
          "default": 0.1,
          "title": "Stroke Outline Width Mm",
          "type": "number"
        },
        "layer_colors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Layer Colors",
          "type": "object"
        },
        "layer_aci": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Layer Aci",
          "type": "object"
        },
        "cut_hairline_mm": {
          "default": 0.01,
          "title": "Cut Hairline Mm",
          "type": "number"
        },
        "png_dpi": {
          "default": 600,
          "title": "Png Dpi",
          "type": "integer"
        },
        "embed_preset": {
          "default": true,
          "title": "Embed Preset",
          "type": "boolean"
        }
      },
      "title": "ExportProfile",
      "type": "object"
    },
    "PreprocessOp": {
      "properties": {
        "op": {
          "enum": [
            "crop",
            "rotate",
            "deskew",
            "background_white",
            "background_sample",
            "upscale",
            "denoise",
            "bilateral",
            "unsharp",
            "levels",
            "gamma",
            "threshold",
            "invert",
            "knockout_halo",
            "morph_open",
            "morph_close",
            "dilate",
            "erode",
            "despeckle",
            "fill_holes",
            "quantize"
          ],
          "title": "Op",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "op"
      ],
      "title": "PreprocessOp",
      "type": "object"
    },
    "PreprocessStack": {
      "properties": {
        "ops": {
          "items": {
            "$ref": "#/$defs/PreprocessOp"
          },
          "title": "Ops",
          "type": "array"
        }
      },
      "title": "PreprocessStack",
      "type": "object"
    },
    "SnapSettings": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "lines_hv45": {
          "default": true,
          "title": "Lines Hv45",
          "type": "boolean"
        },
        "circles": {
          "default": true,
          "title": "Circles",
          "type": "boolean"
        },
        "rounded_rects": {
          "default": true,
          "title": "Rounded Rects",
          "type": "boolean"
        },
        "parallel": {
          "default": false,
          "title": "Parallel",
          "type": "boolean"
        },
        "dedupe_shapes": {
          "default": false,
          "title": "Dedupe Shapes",
          "type": "boolean"
        },
        "angle_tol_deg": {
          "default": 2.0,
          "title": "Angle Tol Deg",
          "type": "number"
        },
        "radius_tol_mm": {
          "default": 0.05,
          "title": "Radius Tol Mm",
          "type": "number"
        }
      },
      "title": "SnapSettings",
      "type": "object"
    },
    "TraceSettings": {
      "properties": {
        "engine": {
          "default": "contour",
          "enum": [
            "contour",
            "potrace",
            "vtracer",
            "centerline"
          ],
          "title": "Engine",
          "type": "string"
        },
        "mode": {
          "default": "outline",
          "enum": [
            "outline",
            "centerline",
            "hybrid"
          ],
          "title": "Mode",
          "type": "string"
        },
        "detail": {
          "default": 0.5,
          "title": "Detail",
          "type": "number"
        },
        "threshold": {
          "default": 128,
          "title": "Threshold",
          "type": "integer"
        },
        "despeckle_mm2": {
          "default": 0.02,
          "title": "Despeckle Mm2",
          "type": "number"
        },
        "corner_sharpness": {
          "default": 0.6,
          "title": "Corner Sharpness",
          "type": "number"
        },
        "min_feature_mm": {
          "default": 0.1,
          "title": "Min Feature Mm",
          "type": "number"
        },
        "smoothness": {
          "default": 0.5,
          "title": "Smoothness",
          "type": "number"
        },
        "curve_tol_mm": {
          "default": 0.03,
          "title": "Curve Tol Mm",
          "type": "number"
        },
        "gap_close_mm": {
          "default": 0.05,
          "title": "Gap Close Mm",
          "type": "number"
        },
        "node_budget": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Budget"
        },
        "union_fills": {
          "default": true,
          "title": "Union Fills",
          "type": "boolean"
        },
        "preserve_holes": {
          "default": true,
          "title": "Preserve Holes",
          "type": "boolean"
        },
        "centerline_max_width_mm": {
          "default": 0.6,
          "title": "Centerline Max Width Mm",
          "type": "number"
        },
        "snap": {
          "$ref": "#/$defs/SnapSettings"
        },
        "cut_outer": {
          "default": false,
          "title": "Cut Outer",
          "type": "boolean"
        }
      },
      "title": "TraceSettings",
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "stack": {
      "$ref": "#/$defs/PreprocessStack"
    },
    "trace": {
      "$ref": "#/$defs/TraceSettings"
    },
    "export": {
      "$ref": "#/$defs/ExportProfile"
    },
    "depth": {
      "$ref": "#/$defs/DepthSettings"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "name",
    "display_name"
  ],
  "title": "Preset",
  "type": "object"
}