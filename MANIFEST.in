# sdist contents beyond the packages themselves
include LICENSE NOTICE README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md
include requirements.txt requirements-ui.txt
recursive-include lasertrace/preset_data *.json
recursive-include lasertrace_ui/assets *.png *.ico
recursive-include tests *.py
recursive-include tools *.py
recursive-include docs *.md
recursive-include schemas *.json
recursive-include sidecars *.py *.md LICENSE
recursive-include fixtures *.png *.jpg *.json
prune docs/assets
global-exclude __pycache__ *.py[cod]
