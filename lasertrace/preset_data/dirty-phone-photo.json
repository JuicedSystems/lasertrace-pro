{
  "name": "dirty-phone-photo",
  "display_name": "Dirty Phone Photo",
  "description": "Deskew, flatten uneven lighting, adaptive threshold, despeckle: for photos of printed logos and signs.",
  "tags": ["photo", "scan", "adaptive"],
  "stack": {
    "ops": [
      {"op": "deskew", "enabled": true, "params": {"max_deg": 15}},
      {"op": "denoise", "enabled": true, "params": {"strength": 8}},
      {"op": "bilateral", "enabled": true, "params": {"d": 7, "sigma_color": 50, "sigma_space": 5}},
      {"op": "threshold", "enabled": true, "params": {"method": "sauvola", "window": 41, "k": 0.25}},
      {"op": "morph_open", "enabled": true, "params": {"radius_mm": 0.03}},
      {"op": "morph_close", "enabled": true, "params": {"radius_mm": 0.05}},
      {"op": "despeckle", "enabled": true, "params": {"min_area_mm2": 0.15}},
      {"op": "fill_holes", "enabled": true, "params": {"max_area_mm2": 0.05}}
    ]
  },
  "trace": {
    "engine": "contour", "mode": "outline",
    "detail": 0.4, "threshold": 128, "despeckle_mm2": 0.15, "corner_sharpness": 0.5,
    "min_feature_mm": 0.25, "smoothness": 0.6,
    "curve_tol_mm": 0.06, "gap_close_mm": 0.1, "node_budget": 2500,
    "union_fills": true, "preserve_holes": true
  },
  "export": {"format": "dxf", "dxf_version": "R2000", "width_mm": 50.0, "origin": "bottom_left", "curves": "polyline", "flatten_tol_mm": 0.03, "precision": 3, "close_fills": true}
}
