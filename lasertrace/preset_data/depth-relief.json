{
  "name": "depth-relief",
  "display_name": "Depth Relief (height map)",
  "description": "Grayscale height map -> cumulative depth slices (black = deepest). 24 slices, 0.5 mm, 8 deg draft; export the depth pack for LightBurn / EZCAD.",
  "tags": ["depth", "3d", "relief"],
  "stack": {
    "ops": [
      {"op": "denoise", "enabled": false, "params": {"strength": 6}}
    ]
  },
  "trace": {
    "engine": "contour", "mode": "outline",
    "detail": 0.5, "threshold": 128, "despeckle_mm2": 0.0, "corner_sharpness": 0.4,
    "min_feature_mm": 0.1, "smoothness": 0.6,
    "curve_tol_mm": 0.03, "gap_close_mm": 0.05, "node_budget": null,
    "union_fills": true, "preserve_holes": true
  },
  "depth": {
    "enabled": true, "levels": 24, "dark_is_deep": true, "total_depth_mm": 0.5,
    "material": "stainless", "laser_w": 50.0, "z_step": true, "z_step_every_mm": 0.1,
    "normalize": true, "depth_gamma": 1.0, "equalize": 0.0,
    "smoothing_mm": 0.05, "edge_preserve": true, "zero_plane": "border", "floor": 0.02,
    "photo_to_relief": false, "feather_mm": 0.0,
    "min_island_mm2": 0.01, "draft_angle_deg": 8.0,
    "quantize_png": false, "png_bits": 8, "png_black_is_deep": true,
    "hatch": {"enabled": false, "spacing_mm": 0.025, "angle_start_deg": 0.0, "angle_step_deg": 37.0, "bidirectional": true, "contour_pass": true}
  },
  "export": {"format": "dxf", "dxf_version": "R2000", "width_mm": 50.0, "origin": "bottom_left", "curves": "polyline", "flatten_tol_mm": 0.02, "precision": 3, "close_fills": true}
}
